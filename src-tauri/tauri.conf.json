{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "파일 도구",
  "mainBinaryName": "win-filetool",
  "version": "0.2.1",
  "identifier": "kr.salarycrew.winfiletool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "파일 도구",
        "width": 820,
        "height": 860,
        "minWidth": 640,
        "minHeight": 560,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "salarycrew",
    "shortDescription": "파일 변환·PDF·감시 폴더 도구",
    "copyright": "salarycrew",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../third_party/pdfium/win-x64/bin/pdfium.dll": "pdfium.dll",
      "../target/x86_64-pc-windows-msvc/release/filetool-svc.exe": "filetool-svc.exe",
      "../third_party/pdfium/win-x64/licenses/": "licenses/pdfium/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
